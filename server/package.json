{
  "name": "trpc-demo-server",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/fix-esm-imports.mjs",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test:e2e": "dotenv -e .env.test.local -- vitest run",
    "test:unit": "echo 'Not implemented'",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name - && prisma generate",
    "db:deploy": "dotenv -e .env.prod.local -- prisma migrate deploy",
    "db:pull": "prisma db pull && prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-mariadb": "~7.7.0",
    "@prisma/client": "~7.7.0",
    "@sapphire/snowflake": "^3.5.5",
    "@scalar/fastify-api-reference": "^1.52.3",
    "@trpc/server": "^11.10.0",
    "ali-oss": "^6.23.0",
    "dayjs": "^1.11.19",
    "fastify": "^5.8.5",
    "mariadb": "^3.4.5",
    "minio": "^8.0.6",
    "superjson": "^2.2.2",
    "trpc-to-openapi": "^3.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@trpc/client": "^11.10.0",
    "@types/ali-oss": "^6.23.3",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "prisma": "~7.7.0",
    "tsx": "^4.19.3"
  }
}
